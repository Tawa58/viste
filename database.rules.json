{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "onlineUsers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "liveNotifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "liveDashboard": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "activeSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "syncStatus": {
      "files": {
        "$fileId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
